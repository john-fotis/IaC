{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":pinDigestsDisabled"
  ],
  "labels": [
    "dependencies",
    "renovate"
  ],
  "timezone": "Europe/Athens",
  "schedule": [
    "after 6pm and before 8pm on friday"
  ],
  "dependencyDashboard": true,
  "minimumReleaseAge": "3 days",
  "pinDigests": false,
  "enabledManagers": [
    "docker-compose"
  ],
  "includePaths": [
    "docker/**"
  ],
  "packageRules": [
    {
      "description": "Group minor/patch/digest for all non-DB images into one weekly PR",
      "matchDatasources": [
        "docker"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ],
      "matchPackageNames": [
        "!/^postgres$/",
        "!/^redis$/"
      ],
      "groupName": "Weekly Docker Minor & Patch Updates"
    },
    {
      "description": "Disable minor/patch/digest for DB images - require manual migration",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "/^postgres$/",
        "/^redis$/"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ],
      "enabled": false
    },
    {
      "description": "Major DB updates get individual PRs",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "/^postgres$/",
        "/^redis$/"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "groupName": null,
      "enabled": true
    },
    {
      "description": "Disable image pinning",
      "matchUpdateTypes": [
        "pin"
      ],
      "enabled": false
    },
    {
      "description": "Pin digests only for latest-tagged images",
      "matchDatasources": [
        "docker"
      ],
      "matchCurrentValue": "latest",
      "pinDigests": true
    },
    {
      "description": "Skip release age check for registries that don't report timestamps",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "/^ghcr\\.io/",
        "/^gcr\\.io/",
        "/^lscr\\.io/"
      ],
      "minimumReleaseAge": "0 days"
    }
  ]
}