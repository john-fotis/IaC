{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":pinDigestsDisabled"
  ],
  "labels": [
    "dependencies",
    "renovate"
  ],
  "timezone": "Europe/Athens",
  "schedule": [
    "after 6pm and before 8pm on friday"
  ],
  "dependencyDashboard": true,
  "minimumReleaseAge": "3 days",
  "enabledManagers": [
    "docker-compose"
  ],
  "includePaths": [
    "docker/**"
  ],
  "packageRules": [
    {
      "description": "Group Docker minor, patch, and digest updates",
      "matchDatasources": [
        "docker"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ],
      "matchPackageNames": [
        "!/postgres/",
        "!/redis/"
      ],
      "groupName": "Weekly Docker Minor & Patch Updates"
    },
    {
      "description": "Silence DB noise (No minor/patch PRs for DBs)",
      "matchPackageNames": [
        "/postgres/",
        "/redis/"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ],
      "enabled": false
    },
    {
      "description": "Standalone PRs for Major updates (Apps & DBs)",
      "matchUpdateTypes": [
        "major"
      ],
      "groupName": null,
      "enabled": true
    },
    {
      "description": "Enable digest pinning for ALL non-DB images",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "!/postgres/",
        "!/redis/"
      ],
      "pinDigests": true
    }
  ]
}